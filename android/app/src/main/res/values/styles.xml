<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="OneUITheme">
        <item name="colorPrimary">@color/matte_primary</item>
        <item name="colorPrimaryDark">@color/matte_primary</item>
        <item name="colorControlActivated">@color/matte_primary</item>
        <item name="android:fontFamily">@font/pretendard_family</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/matte_background</item>
        <item name="android:colorBackground">@color/matte_background</item>
        <item name="android:colorAccent">@color/matte_primary</item>
        <item name="android:navigationBarColor">@color/matte_background</item>
        <item name="android:statusBarColor">@color/matte_background</item>
        <item name="buttonCornerRadius">14dp</item>
    </style>

    <style name="AppTheme.MaterialYou" parent="AppTheme" />

    <style name="HudToolbarTitle" parent="TextAppearance.AppCompat.Title">
        <item name="android:fontFamily">@font/pretendard_bold</item>
        <item name="fontFamily">@font/pretendard_bold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/oneui_text_primary</item>
    </style>

    <style name="App.ContainedPrimaryColorButtonTheme" parent="OneUI.ContainedPrimaryColorButtonTheme">
        <item name="buttonCornerRadius">14dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/pretendard_family</item>
    </style>

    <style name="AppThemeDark" parent="AppTheme" />
    <style name="AppThemeLight" parent="AppTheme" />
</resources>
